{
  // Lead Reactivation on Cloudflare Workers (via @opennextjs/cloudflare).
  // Secrets are NOT here. Add them with: npx wrangler secret put NAME
  //   OPENAI_API_KEY, DATA_ENCRYPTION_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, RESEND_API_KEY
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lead-reactivation",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lead-reactivation",
      // Created 21 Oct 2026 in the RaynesWebSphere Cloudflare account; tables from migrations/ applied.
      "database_id": "ceb7b349-939d-4daa-81bc-19262990a660",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "LOGIN_EMAIL_FROM": "RaynesWebSphere <website@rayneswebsphere.com>",
    // Public address (used for the Google sign-in return). Change when a custom domain is added.
    "APP_URL": "https://lead-reactivation.rayneswebsphere.workers.dev"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
